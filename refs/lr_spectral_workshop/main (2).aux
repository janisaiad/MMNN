\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The 1D CPWL exponent remains pinned near $-4$. This negative result is theoretically expected and motivates measuring learned Fourier recovery instead.\relax }}{6}{figure.caption.8}\protected@file@percent }

\@writefile{toc}{\contentsline {section}{\numberline {11}Conclusion}{6}{section.11}\protected@file@percent }
\bibcite{kamalakara2022lowrank}{11}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Width-$2^{15}$ Fourier/kernel rank sweep. Solid curves sweep ranks $1,\ldots  ,50$; dashed lines are the full-rank endpoint. The same intermediate rank lowers finite-budget MSE and makes the learned Fourier recovery scaling visibly flatter. High/low recovery and the bound decomposition are shown in the appendix.\relax }}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:ranksweep}{{5}{7}{Width-$2^{15}$ Fourier/kernel rank sweep. Solid curves sweep ranks $1,\ldots ,50$; dashed lines are the full-rank endpoint. The same intermediate rank lowers finite-budget MSE and makes the learned Fourier recovery scaling visibly flatter. High/low recovery and the bound decomposition are shown in the appendix.\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Saturation diagnostic for the Fourier scaling law. Solid curves show the useful log--log scaling exponent extracted from recovery; dotted curves show the raw fitted exponent. The dashed vertical line marks $r=4$: the risk curve has its visible minimum around this rank, whereas the marginal spectral gain enters the low plateau afterwards. This is the operational sweet spot: ranks below $4$ are still approximation-limited, while ranks above $4$ add complexity without improving the finite-bandwidth scaling law.\relax }}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:plateau}{{6}{8}{Saturation diagnostic for the Fourier scaling law. Solid curves show the useful log--log scaling exponent extracted from recovery; dotted curves show the raw fitted exponent. The dashed vertical line marks $r=4$: the risk curve has its visible minimum around this rank, whereas the marginal spectral gain enters the low plateau afterwards. This is the operational sweet spot: ranks below $4$ are still approximation-limited, while ranks above $4$ add complexity without improving the finite-bandwidth scaling law.\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Fourier-space validation. Top: rank $4$ gives a visibly flatter recovery scaling law than the full endpoint. Bottom: the same rank reaches a lower finite-budget test error.\relax }}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:recovery}{{7}{9}{Fourier-space validation. Top: rank $4$ gives a visibly flatter recovery scaling law than the full endpoint. Bottom: the same rank reaches a lower finite-budget test error.\relax }{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Stress tests for the optimal rank rule. Left: best rank across widths $2^{10}$ to $2^{20}$. Right: best rank across Fourier-mixture dimensions $1,2,3,5,10,20,30$. The optimum remains a low intermediate rank rather than the full endpoint, consistent with the approximation/optimization balance.\relax }}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:widthdim}{{8}{9}{Stress tests for the optimal rank rule. Left: best rank across widths $2^{10}$ to $2^{20}$. Right: best rank across Fourier-mixture dimensions $1,2,3,5,10,20,30$. The optimum remains a low intermediate rank rather than the full endpoint, consistent with the approximation/optimization balance.\relax }{figure.caption.13}{}}

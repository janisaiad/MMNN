\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Adam loss curve showing symmetric spikes.} Factor 2, $N=512$, batch 512, depth 1. The repeated down-then-up spikes indicate that the optimizer repeatedly enters very deep valleys (very low loss) and then leaves them, supporting the picture of a plateau with many sharp holes.}}{10}{figure.9}\protected@file@percent }
\newlabel{fig:adam_loss_f2_L1}{{9}{10}{\textbf {Adam loss curve showing symmetric spikes.} Factor 2, $N=512$, batch 512, depth 1. The repeated down-then-up spikes indicate that the optimizer repeatedly enters very deep valleys (very low loss) and then leaves them, supporting the picture of a plateau with many sharp holes}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Adam loss curves. \textbf  {(a)} f2, $N=512$, bs 512, $L=3$. \textbf  {(b)} f3, $N=768$, bs 512, $L=1$. \textbf  {(c)} f4, $N=512$, bs 512, $L=1$. \textbf  {(d)} f4, $N=512$, bs 512, $L=4$. Symmetric spikes indicate a landscape with many deep valleys.}}{10}{figure.10}\protected@file@percent }
\newlabel{fig:app-adam-curves}{{10}{10}{Adam loss curves. \textbf {(a)} f2, $N=512$, bs 512, $L=3$. \textbf {(b)} f3, $N=768$, bs 512, $L=1$. \textbf {(c)} f4, $N=512$, bs 512, $L=1$. \textbf {(d)} f4, $N=512$, bs 512, $L=4$. Symmetric spikes indicate a landscape with many deep valleys}{figure.10}{}}

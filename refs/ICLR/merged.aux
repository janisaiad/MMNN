\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Loss and fit around learning-rate reductions.} Left: depth $L=2$; right: $L=3$. Training on a sum of three cosines ($N=768$, batch 8). The curves show how the global fit (blue) approaches the target (orange) in stages: after each LR cut the loss drops and the predictor gains finer oscillations in the interior of $[-1,1]$, reflecting descent into a deeper valley of the landscape.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:loss_fit_L2}{{1}{2}{\textbf {Loss and fit around learning-rate reductions.} Left: depth $L=2$; right: $L=3$. Training on a sum of three cosines ($N=768$, batch 8). The curves show how the global fit (blue) approaches the target (orange) in stages: after each LR cut the loss drops and the predictor gains finer oscillations in the interior of $[-1,1]$, reflecting descent into a deeper valley of the landscape}{figure.1}{}}
\newlabel{fig:loss_fit_L3}{{1}{2}{\textbf {Loss and fit around learning-rate reductions.} Left: depth $L=2$; right: $L=3$. Training on a sum of three cosines ($N=768$, batch 8). The curves show how the global fit (blue) approaches the target (orange) in stages: after each LR cut the loss drops and the predictor gains finer oscillations in the interior of $[-1,1]$, reflecting descent into a deeper valley of the landscape}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Channel partials before and after LR divides} (depth $L=3$, same setup). Each curve is the scalar output of one low-rank channel over the input domain. After long training and an LR reduction, the partials develop visible high-frequency structure in the middle of the interval, matching the moment when the trajectory enters a sharp valley and the network picks up higher modes.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:partial_L3}{{2}{2}{\textbf {Channel partials before and after LR divides} (depth $L=3$, same setup). Each curve is the scalar output of one low-rank channel over the input domain. After long training and an LR reduction, the partials develop visible high-frequency structure in the middle of the interval, matching the moment when the trajectory enters a sharp valley and the network picks up higher modes}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Log-ratio evolution at $x=0$.} Left: the maximum log-ratio between channel pairs grows over epochs when channels specialize. Right: the full set of pairwise log-ratios over training; a spread, roughly uniform distribution in log space indicates that different channels take on distinct roles.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:trajectory}{{3}{3}{\textbf {Log-ratio evolution at $x=0$.} Left: the maximum log-ratio between channel pairs grows over epochs when channels specialize. Right: the full set of pairwise log-ratios over training; a spread, roughly uniform distribution in log space indicates that different channels take on distinct roles}{figure.3}{}}
\newlabel{fig:logratio-heatmap}{{3}{3}{\textbf {Log-ratio evolution at $x=0$.} Left: the maximum log-ratio between channel pairs grows over epochs when channels specialize. Right: the full set of pairwise log-ratios over training; a spread, roughly uniform distribution in log space indicates that different channels take on distinct roles}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Oscillatory complexity across layers.} Mean number of strict local minima per channel (on layer-$\ell $ partials) vs.\ layer index $\ell $ for a network with $L=6$ blocks, width 128, rank 5. The rise with depth is consistent with the conjecture that layer $L$ exhibits on the order of $2L$ spikes and that later layers develop more oscillatory internal representations.}}{3}{figure.4}\protected@file@percent }
\newlabel{fig:mean-minima-vs-layer}{{4}{3}{\textbf {Oscillatory complexity across layers.} Mean number of strict local minima per channel (on layer-$\ell $ partials) vs.\ layer index $\ell $ for a network with $L=6$ blocks, width 128, rank 5. The rise with depth is consistent with the conjecture that layer $L$ exhibits on the order of $2L$ spikes and that later layers develop more oscillatory internal representations}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Symmetry preservation: low-rank vs.\ full-rank.} Top row: full-rank MLP (random features removed) at layers 7 and 16; the channel partials are visibly asymmetric about $x=0$ despite a symmetric target. Bottom row: low-rank (RF-LR) with the same hyperparameters; the partials remain symmetric, so the low-rank constraint acts as an implicit regularizer for the target geometry.}}{3}{figure.5}\protected@file@percent }
\newlabel{fig:mlp-asymmetry}{{5}{3}{\textbf {Symmetry preservation: low-rank vs.\ full-rank.} Top row: full-rank MLP (random features removed) at layers 7 and 16; the channel partials are visibly asymmetric about $x=0$ despite a symmetric target. Bottom row: low-rank (RF-LR) with the same hyperparameters; the partials remain symmetric, so the low-rank constraint acts as an implicit regularizer for the target geometry}{figure.5}{}}

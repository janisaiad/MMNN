\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Endpoint diagrams for the constants in \eqref  {eq:endpoint-constants}. A \(V\)-source has no transported NTK leg and gives \(\operatorname  {Var}(X_0)=5\). A mixed \(C\)-diagram has one off-diagonal NTK leg transported by \((k/L)^3\), giving \(B_3=21/20\). An \(A\)-diagram has two such transported legs, giving \(A_{3,3}=173/720\).}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:endpoint-constant-diagrams}{{2}{6}{Endpoint diagrams for the constants in \eqref {eq:endpoint-constants}. A \(V\)-source has no transported NTK leg and gives \(\Var (X_0)=5\). A mixed \(C\)-diagram has one off-diagonal NTK leg transported by \((k/L)^3\), giving \(B_3=21/20\). An \(A\)-diagram has two such transported legs, giving \(A_{3,3}=173/720\)}{figure.2}{}}

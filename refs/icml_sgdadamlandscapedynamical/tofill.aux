\newlabel{rem:nonsymmetry}{{4.1}{8}{Non-symmetry of learned functions}{theorem.4.1}{}}
\newlabel{rem:nonsymmetry@cref}{{[remark][1][4]4.1}{[1][8][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Illustration of non-symmetry in learned functions. The target function $f(x) = \cos (f_1 \pi x^2) - 0.8 \cos (f_2 \pi x^2)$ is symmetric about $x=0$ (dashed line), but the learned function (solid line) exhibits asymmetric structures. This asymmetry emerges from channel specialization, where different channels capture different spatial regions or frequency components asymmetrically, despite the symmetric target and large batch SGD training.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:nonsymmetry}{{6}{8}{Illustration of non-symmetry in learned functions. The target function $f(x) = \cos (f_1 \pi x^2) - 0.8 \cos (f_2 \pi x^2)$ is symmetric about $x=0$ (dashed line), but the learned function (solid line) exhibits asymmetric structures. This asymmetry emerges from channel specialization, where different channels capture different spatial regions or frequency components asymmetrically, despite the symmetric target and large batch SGD training}{figure.caption.7}{}}
\newlabel{fig:nonsymmetry@cref}{{[figure][6][]6}{[1][8][]8}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Mean-Field Analysis of Channel Specialization}{8}{subsection.4.4}\protected@file@percent }
\newlabel{sec:meanfield-analysis}{{4.4}{8}{}{subsection.4.4}{}}
\newlabel{sec:meanfield-analysis@cref}{{[subsection][4][4]4.4}{[1][8][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Log-ratio heatmap showing channel specialization structure. Each entry $(i,j)$ shows $\log (|f_i|) - \log (|f_j|)$ at $x \approx 0$. Strong off-diagonal patterns indicate that different channels have specialized to different magnitudes, validating the channel specialization mechanism predicted by Lemma~\ref {lem:r2-logratio-criterion-main}.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:logratio-heatmap}{{7}{9}{Log-ratio heatmap showing channel specialization structure. Each entry $(i,j)$ shows $\log (|f_i|) - \log (|f_j|)$ at $x \approx 0$. Strong off-diagonal patterns indicate that different channels have specialized to different magnitudes, validating the channel specialization mechanism predicted by Lemma~\ref {lem:r2-logratio-criterion-main}}{figure.caption.8}{}}
\newlabel{fig:logratio-heatmap@cref}{{[figure][7][]7}{[1][8][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Evolution of log-ratio statistics over training time. The growing max/min divergence while mean stays near zero indicates that channels specialize in different ways rather than all becoming similar, consistent with the hierarchical frequency learning mechanism.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:logratio-statistics}{{8}{9}{Evolution of log-ratio statistics over training time. The growing max/min divergence while mean stays near zero indicates that channels specialize in different ways rather than all becoming similar, consistent with the hierarchical frequency learning mechanism}{figure.caption.9}{}}
\newlabel{fig:logratio-statistics@cref}{{[figure][8][]8}{[1][8][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Channel shares showing relative contribution of each channel. Uneven shares (deviating from uniform $1/r \approx 0.067$) directly demonstrate which channels have specialized to be more active, providing empirical validation of the channel specialization mechanism.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:channel-shares}{{9}{9}{Channel shares showing relative contribution of each channel. Uneven shares (deviating from uniform $1/r \approx 0.067$) directly demonstrate which channels have specialized to be more active, providing empirical validation of the channel specialization mechanism}{figure.caption.10}{}}
\newlabel{fig:channel-shares@cref}{{[figure][9][]9}{[1][8][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Time evolution of log-ratio distributions. The widening distributions over time show that channels progressively differentiate, with specialization stabilizing around $t=2500$ and remaining stable until $t=5000$, matching theoretical predictions that channel dominance is preserved once established.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:logratio-evolution}{{10}{9}{Time evolution of log-ratio distributions. The widening distributions over time show that channels progressively differentiate, with specialization stabilizing around $t=2500$ and remaining stable until $t=5000$, matching theoretical predictions that channel dominance is preserved once established}{figure.caption.11}{}}
\newlabel{fig:logratio-evolution@cref}{{[figure][10][]10}{[1][8][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Weight density in log-log scale revealing power-law behavior $P(|w|) \propto |w|^{-\alpha }$. This scale-invariant distribution is characteristic of critical behavior in mean-field dynamics and reflects the hierarchical structure learned by the network.}}{10}{figure.caption.12}\protected@file@percent }
\newlabel{fig:weight-density-loglog}{{11}{10}{Weight density in log-log scale revealing power-law behavior $P(|w|) \propto |w|^{-\alpha }$. This scale-invariant distribution is characteristic of critical behavior in mean-field dynamics and reflects the hierarchical structure learned by the network}{figure.caption.12}{}}
\newlabel{fig:weight-density-loglog@cref}{{[figure][11][]11}{[1][8][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Time evolution of weight distributions. The progression from initial Gaussian distribution to final heavy-tailed distribution reflects how the mean-field ODE dynamics shape the learned representation, with weights evolving to capture the hierarchical frequency structure.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:weight-evolution}{{12}{10}{Time evolution of weight distributions. The progression from initial Gaussian distribution to final heavy-tailed distribution reflects how the mean-field ODE dynamics shape the learned representation, with weights evolving to capture the hierarchical frequency structure}{figure.caption.13}{}}
\newlabel{fig:weight-evolution@cref}{{[figure][12][]12}{[1][8][]10}}

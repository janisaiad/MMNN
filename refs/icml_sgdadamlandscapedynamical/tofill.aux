\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Illustration of non-symmetry in learned functions. The target function $f(x) = \cos (f_1 \pi x^2) - 0.8 \cos (f_2 \pi x^2)$ is symmetric about $x=0$ (dashed line), but the learned function (solid line) exhibits asymmetric structures. This asymmetry emerges from channel specialization, where different channels capture different spatial regions or frequency components asymmetrically, despite the symmetric target and large batch SGD training.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:nonsymmetry}{{6}{8}{Illustration of non-symmetry in learned functions. The target function $f(x) = \cos (f_1 \pi x^2) - 0.8 \cos (f_2 \pi x^2)$ is symmetric about $x=0$ (dashed line), but the learned function (solid line) exhibits asymmetric structures. This asymmetry emerges from channel specialization, where different channels capture different spatial regions or frequency components asymmetrically, despite the symmetric target and large batch SGD training}{figure.caption.7}{}}
\newlabel{fig:nonsymmetry@cref}{{[figure][6][]6}{[1][8][]8}}

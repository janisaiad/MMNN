\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Ablation study results on frequency-dependent function approximation. fixWb=True (frozen random features) consistently outperforms fixWb=False (fully trainable), and low-rank configurations achieve excellent performance across all frequency regimes. Params shows parameter count (K=thousands, M=millions). Ratio = Test MSE (False) / Test MSE (True) for same rank, showing improvement factor. Low-rank (rank 10-100) reduces parameters by 77-97\% compared to full-rank (777), while achieving superior performance through channel specialization that enables hierarchical frequency learning.}}{7}{table.caption.3}\protected@file@percent }
\newlabel{tab:main-results}{{1}{7}{Ablation study results on frequency-dependent function approximation. fixWb=True (frozen random features) consistently outperforms fixWb=False (fully trainable), and low-rank configurations achieve excellent performance across all frequency regimes. Params shows parameter count (K=thousands, M=millions). Ratio = Test MSE (False) / Test MSE (True) for same rank, showing improvement factor. Low-rank (rank 10-100) reduces parameters by 77-97\% compared to full-rank (777), while achieving superior performance through channel specialization that enables hierarchical frequency learning}{table.caption.3}{}}
\newlabel{tab:main-results@cref}{{[table][1][]1}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Loss vs time (log scale) for different ranks $r$ on frequency-dependent function approximation. The decay is clearly exponential/polynomial, demonstrating global convergence for non-convex losses.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:loss-time}{{3}{7}{Loss vs time (log scale) for different ranks $r$ on frequency-dependent function approximation. The decay is clearly exponential/polynomial, demonstrating global convergence for non-convex losses}{figure.caption.4}{}}
\newlabel{fig:loss-time@cref}{{[figure][3][]3}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Fitted convergence rates ($\lambda $ or $\alpha $) vs rank $r$. Comparison with theoretical prediction.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:rate-rank}{{4}{7}{Fitted convergence rates ($\lambda $ or $\alpha $) vs rank $r$. Comparison with theoretical prediction}{figure.caption.5}{}}
\newlabel{fig:rate-rank@cref}{{[figure][4][]4}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Test error vs frequency for different configurations. fixWb=True (solid lines) consistently outperforms fixWb=False (dashed lines) across all frequency regimes, with dramatic improvements at high frequencies.}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:frequency-error}{{5}{7}{Test error vs frequency for different configurations. fixWb=True (solid lines) consistently outperforms fixWb=False (dashed lines) across all frequency regimes, with dramatic improvements at high frequencies}{figure.caption.6}{}}
\newlabel{fig:frequency-error@cref}{{[figure][5][]5}{[1][7][]7}}

\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Ablation study results on frequency-dependent function approximation. fixWb=True (frozen random features) consistently outperforms fixWb=False (fully trainable), and low-rank configurations achieve excellent performance across all frequency regimes. Params shows parameter count (K=thousands, M=millions). Ratio = Test MSE (False) / Test MSE (True) for same rank, showing improvement factor. Low-rank (rank 10-100) reduces parameters by 77-97\% compared to full-rank (1024), while achieving superior performance through channel feature learning that enables hierarchical frequency learning.}}{28}{table.caption.25}\protected@file@percent }
\newlabel{tab:main-results}{{2}{28}{Ablation study results on frequency-dependent function approximation. fixWb=True (frozen random features) consistently outperforms fixWb=False (fully trainable), and low-rank configurations achieve excellent performance across all frequency regimes. Params shows parameter count (K=thousands, M=millions). Ratio = Test MSE (False) / Test MSE (True) for same rank, showing improvement factor. Low-rank (rank 10-100) reduces parameters by 77-97\% compared to full-rank (1024), while achieving superior performance through channel feature learning that enables hierarchical frequency learning}{table.caption.25}{}}
\newlabel{tab:main-results@cref}{{[table][2][2147483647]2}{[1][27][]28}}

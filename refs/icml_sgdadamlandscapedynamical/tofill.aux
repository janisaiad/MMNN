\newlabel{fig:rate-rank@cref}{{[figure][4][]4}{[1][8][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Test error vs frequency for different configurations. fixWb=True (solid lines) consistently outperforms fixWb=False (dashed lines) across all frequency regimes, with dramatic improvements at high frequencies.}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:frequency-error}{{5}{8}{Test error vs frequency for different configurations. fixWb=True (solid lines) consistently outperforms fixWb=False (dashed lines) across all frequency regimes, with dramatic improvements at high frequencies}{figure.caption.6}{}}

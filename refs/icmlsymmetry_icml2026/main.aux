\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Partial functions before and after LR divides for $f_3$, $N=768$, batch size $8$, depth $L=3$. This is the current source image behind the ICLR Figure 5 claim.}}{5}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Automatic quick-run diagnostic: output, partial-function, and mirror-pair weight-space symmetry defects.}}{6}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mirror-pair weight-space diagnostic in the first layer.}}{6}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Long-grid diagnostic: output-space symmetry versus active last-layer partial-function symmetry. Full-rank MLPs can have even outputs while keeping asymmetric active hidden features.}}{7}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Layerwise partial-function symmetry heatmap across the long grid. The late MMNN bottleneck layers, especially at depth $3$, show much smaller active symmetry defects.}}{7}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Weight-space mirror mismatch versus active partial symmetry. The current nearest-mirror metric moves in the expected direction but is weaker than the function-space separation.}}{8}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Low-loss ICLR configs: final test MSE versus active last-layer partial symmetry defect. These are the reliable symmetry runs.}}{8}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Low-loss ICLR configs grouped by rank. Late bottleneck partials remain strongly even after fitting the target.}}{9}{figure.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Completed ICLR reruns: final test MSE versus active partial symmetry, colored by median outgoing mirror mismatch in weight space.}}{9}{figure.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Distribution of outgoing mirror-pair mismatch across partial-symmetric, output-only/asymmetric, intermediate, and underfit regimes.}}{10}{figure.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces First-layer atoms $(a_j,b_j)$ and nearest mirror-pair links for a symmetric run (left) and an output-only/asymmetric run (right). Color denotes outgoing coefficient mismatch.}}{10}{figure.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces MNIST practical ablation: test accuracy versus batch size for MLP and MMNN.}}{11}{figure.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces MNIST transform-defect diagnostics. These are representation-stability proxies, not label-preserving symmetry guarantees.}}{11}{figure.13}\protected@file@percent }

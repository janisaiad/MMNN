\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Spectral powers move sparse-target sector clocks.} Median half-error steps at affine depth five for maximal-update gradient descent, polar Muon, and Muon\({}^p\) with \(p=1/3,2/3\). Optimizers are calibrated on disjoint seeds and compared on paired initializations. Open downward triangles mark a right-censored median at the common horizon. Earlier crossings do not imply lower terminal risk or complete event coverage.}}{19}{figure.caption.7}\protected@file@percent }
\newlabel{fig:muon-clocks}{{6}{19}{\textbf {Spectral powers move sparse-target sector clocks.} Median half-error steps at affine depth five for maximal-update gradient descent, polar Muon, and Muon\({}^p\) with \(p=1/3,2/3\). Optimizers are calibrated on disjoint seeds and compared on paired initializations. Open downward triangles mark a right-censored median at the common horizon. Earlier crossings do not imply lower terminal risk or complete event coverage}{figure.caption.7}{}}
\newlabel{fig:muon-clocks@cref}{{[figure][6][]6}{[1][15][]19}}

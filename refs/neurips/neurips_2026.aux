\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mechanism behind low-rank spectral bias. Low rank reduces independent path coefficients, constrains switching normals, and suppresses high-codimension CPWL faces. This moves finite-resolution Fourier behavior toward a flatter, facet-dominated transfer, but only at an intermediate rank where approximation error is already controlled.\relax }}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:mechanism-summary}{{2}{8}{Mechanism behind low-rank spectral bias. Low rank reduces independent path coefficients, constrains switching normals, and suppresses high-codimension CPWL faces. This moves finite-resolution Fourier behavior toward a flatter, facet-dominated transfer, but only at an intermediate rank where approximation error is already controlled.\relax }{figure.caption.11}{}}
\newlabel{eq:recovery}{{33}{8}{Face Fourier expansion}{equation.4.33}{}}

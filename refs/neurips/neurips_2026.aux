\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Theory proxy for the Fourier shell law. Panels A--B show relative face-moment proxies $M_2/M_1$ and $M_3/M_1$, i.e. how much higher-codimension geometry is present relative to facets. Panel C shows the induced finite-shell slope, separating the universal codimension exponents from the rank-dependent coefficients.\relax }}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:theory-proxy-main}{{3}{7}{Theory proxy for the Fourier shell law. Panels A--B show relative face-moment proxies $M_2/M_1$ and $M_3/M_1$, i.e. how much higher-codimension geometry is present relative to facets. Panel C shows the induced finite-shell slope, separating the universal codimension exponents from the rank-dependent coefficients.\relax }{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Three-dimensional CPWL geometry proxy. Panels A--B show the fraction of sampled neighborhoods where many affine regions meet, using thresholds of 8 and 4 regions as empirical high- and medium-codimension junction proxies. Panel C shows the number of linear regions, and Panel D shows the estimated shell slope.\relax }}{8}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cpwl3d-main}{{4}{8}{Three-dimensional CPWL geometry proxy. Panels A--B show the fraction of sampled neighborhoods where many affine regions meet, using thresholds of 8 and 4 regions as empirical high- and medium-codimension junction proxies. Panel C shows the number of linear regions, and Panel D shows the estimated shell slope.\relax }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Rank-shift control. The left panel shows finite-budget MSE versus rank for several target/weighting regimes; the right panel shows the best rank in each regime. Dashed lines are full-rank baselines. The plot emphasizes that the useful rank moves with the spectrum and objective rather than staying fixed.\relax }}{8}{figure.caption.14}\protected@file@percent }
\newlabel{fig:rank-shift-control}{{5}{8}{Rank-shift control. The left panel shows finite-budget MSE versus rank for several target/weighting regimes; the right panel shows the best rank in each regime. Dashed lines are full-rank baselines. The plot emphasizes that the useful rank moves with the spectrum and objective rather than staying fixed.\relax }{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Mode-wise recovery and training curves. Panels A and C show Fourier recovery ratios $R_r(k,t)$ across frequency modes: higher and flatter curves mean that high frequencies are recovered more evenly relative to low frequencies. Panels B and D show normalized excess MSE during training, so the useful ranks are those that combine low error with flatter spectral recovery.\relax }}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:recovery-training-main}{{6}{8}{Mode-wise recovery and training curves. Panels A and C show Fourier recovery ratios $R_r(k,t)$ across frequency modes: higher and flatter curves mean that high frequencies are recovered more evenly relative to low frequencies. Panels B and D show normalized excess MSE during training, so the useful ranks are those that combine low error with flatter spectral recovery.\relax }{figure.caption.15}{}}

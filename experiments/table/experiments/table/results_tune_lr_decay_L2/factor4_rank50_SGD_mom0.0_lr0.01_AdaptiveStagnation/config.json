{
  "factor": 4,
  "num_layers": 2,
  "hidden_rank": 50,
  "hidden_width": 1024,
  "num_epochs": 10000,
  "batch_size": 160,
  "lr_init": 0.01,
  "optimizer_type": "SGD",
  "scheduler_type": "AdaptiveStagnation",
  "scheduler_params": {
    "lr_sequence": [
      0.01,
      0.005,
      0.001,
      0.0005,
      0.0001
    ],
    "window_size": 10,
    "min_epochs_before_reduce": 20
  },
  "momentum": 0.0,
  "betas": null,
  "function": "cos(2*4*pi*x)",
  "parameterization": "NTK",
  "initialization": "uniform[-1,1]/sqrt(n)"
}
{
  "factor": 1,
  "num_layers": 2,
  "hidden_rank": 10,
  "hidden_width": 1024,
  "num_epochs": 20,
  "batch_size": 40,
  "lr_init": 0.01,
  "optimizer_type": "SGD",
  "momentum": 0.5,
  "scheduler_type": "AdaptiveStagnation",
  "scheduler_params": {
    "lr_sequence": [
      0.01,
      0.005,
      0.001,
      0.0005,
      0.0001
    ],
    "window_size": 10,
    "min_epochs_before_reduce": 20
  },
  "function": "cos(2*1*pi*x)+cos(2*pi*x)"
}